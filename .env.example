# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/live_data_hub

# External Provider Configurations (Open-Meteo services)
# Overriding these allows testing failure drills (e.g., pointing to invalid host)
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
AIR_QUALITY_API_BASE_URL=https://air-quality-api.open-meteo.com/v1

# Network & Resilience Settings
EXTERNAL_REQUEST_TIMEOUT_MS=5000
